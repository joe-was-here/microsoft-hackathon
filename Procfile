web: if [ -f backend/main.py ]; then cd backend && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}; elif [ -f main.py ] && [ -f requirements.txt ]; then uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}; elif [ -f package.json ] && command -v pnpm >/dev/null 2>&1; then pnpm preview --host 0.0.0.0 --port ${PORT:-3000}; else caddy run --config /assets/Caddyfile --adapter caddyfile; fi